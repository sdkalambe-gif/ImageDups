<Window x:Class="ImageDups.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image and video duplicate finder" Height="760" Width="1120"
        MinHeight="600" MinWidth="900"
        Background="#F4F6FA">
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#D94B4B"
                                     Geometry="M4,0 H12 A4,4 0 0 1 16,4 V12 A4,4 0 0 1 12,16 H4 A4,4 0 0 1 0,12 V4 A4,4 0 0 1 4,0 Z" />
                    <GeometryDrawing Brush="#8AD8CC"
                                     Geometry="M3,2 H10 V11 H3 Z" />
                    <GeometryDrawing Brush="White"
                                     Geometry="M6,5 H13 A1,1 0 0 1 14,6 V13 A1,1 0 0 1 13,14 H6 A1,1 0 0 1 5,13 V6 A1,1 0 0 1 6,5 Z" />
                    <GeometryDrawing Brush="#27A895"
                                     Geometry="M6,12 L8.3,9.5 L9.8,11 L11.1,9.8 L13,12 Z" />
                    <GeometryDrawing Brush="#D94B4B"
                                     Geometry="M7,7 A1,1 0 1 1 9,7 A1,1 0 1 1 7,7 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3157D5" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#F2F4F7" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ButtonContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E4E7EC" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#101828" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D0D5DD" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#101828" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Primary" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2546B8" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Primary" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D3690" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Danger" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#8F1D14" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Danger" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#70170F" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAECF0" />
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#667085" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Margin="0,0,0,4" Background="White"
                BorderBrush="#E2E6EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Master storage" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#344054" Margin="0,0,14,0" />
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MasterFolderTextBox" Grid.Column="0" IsReadOnly="True"
                             Background="#F9FAFB" />
                    <Border Grid.Column="1" Width="164" Margin="8,0,0,0" Padding="8,3"
                            Background="#F9FAFB" BorderBrush="#E2E6EF" BorderThickness="1"
                            CornerRadius="4" VerticalAlignment="Stretch">
                        <TextBlock x:Name="MasterImageCountTextBlock"
                                   Text="Not scanned"
                                   Foreground="#475467" FontSize="10" VerticalAlignment="Center"
                                   ToolTip="Master media files: total discovered, read from cache, and processed this scan." />
                    </Border>
                </Grid>
                <Button x:Name="ChooseMasterFolderButton" Grid.Row="0" Grid.Column="2" Content="Choose folder..."
                        Click="ChooseMasterFolder_Click" />
                <Button x:Name="CompareButton" Grid.Row="0" Grid.Column="3"
                        Content="Start comparison" Click="Compare_Click"
                        Tag="Primary"
                        ToolTip="Compare images by byte and perceptual similarity; videos match only when their file contents are identical. Review results and safely send selected current-folder copies to the Recycle Bin."
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Current files" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#344054" Margin="0,0,14,0" />
                <Grid Grid.Row="2" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CurrentFolderTextBox" Grid.Column="0" IsReadOnly="True"
                             Background="#F9FAFB" />
                    <Border Grid.Column="1" Width="164" Margin="8,0,0,0" Padding="8,3"
                            Background="#F9FAFB" BorderBrush="#E2E6EF" BorderThickness="1"
                            CornerRadius="4" VerticalAlignment="Stretch">
                        <TextBlock x:Name="CurrentImageCountTextBlock"
                                   Text="Not scanned"
                                   Foreground="#475467" FontSize="10" VerticalAlignment="Center"
                                   ToolTip="Current media files: total discovered, read from cache, and processed this scan." />
                    </Border>
                </Grid>
                <Button x:Name="ChooseCurrentFolderButton" Grid.Row="2" Grid.Column="2" Content="Choose folder..."
                        Click="ChooseCurrentFolder_Click" />

                <Button x:Name="DeleteButton" Grid.Row="2" Grid.Column="3" Content="Send selected to Recycle Bin"
                        Click="DeleteSelected_Click" IsEnabled="False"
                        ToolTip="Send selected matching current-folder images or videos to the Recycle Bin"
                        Tag="Danger"
                        Background="#B42318" Foreground="White" BorderThickness="0" />

                <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ByteSimilarityThresholdPanel" Grid.Column="0"
                                Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Minimum byte-content similarity" VerticalAlignment="Center"
                                   ToolTip="Percentage of equal bytes at the same file positions, divided by the larger file size. SHA-256 itself has no similarity percentage."
                                   FontWeight="SemiBold" Foreground="#344054" Margin="0,0,10,0" />
                        <Button x:Name="DecreaseByteThresholdButton" Content="-" Width="38" Padding="0,5"
                                Margin="0,0,6,0" Click="DecreaseThreshold_Click"
                                ToolTip="Decrease the byte-content match threshold by 1%" />
                        <TextBlock x:Name="ByteThresholdTextBlock" Text="96%" MinWidth="42"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   FontSize="14" FontWeight="Bold" Foreground="#172033" />
                        <Button x:Name="IncreaseByteThresholdButton" Content="+" Width="38" Padding="0,5"
                                Margin="6,0,0,0" Click="IncreaseThreshold_Click"
                                ToolTip="Increase the byte-content match threshold by 1%" />
                        <TextBlock Text="(90%–100%)" VerticalAlignment="Center"
                                   Foreground="#667085" FontSize="12" Margin="9,0,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PHashSimilarityThresholdPanel" Grid.Column="1" Orientation="Horizontal"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Width="1" Height="28" Margin="0,0,12,0"
                                Background="#D0D5DD" />
                        <TextBlock Text="Minimum pHash similarity" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="#344054" Margin="0,0,10,0" />
                        <Button x:Name="DecreasePHashThresholdButton" Content="-" Width="38" Padding="0,5"
                                Margin="0,0,6,0" Click="DecreasePHashThreshold_Click"
                                ToolTip="Decrease the pHash match threshold by 1%" />
                        <TextBlock x:Name="PHashThresholdTextBlock" Text="100%" MinWidth="42"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   FontSize="14" FontWeight="Bold" Foreground="#172033" />
                        <Button x:Name="IncreasePHashThresholdButton" Content="+" Width="38" Padding="0,5"
                                Margin="6,0,0,0" Click="IncreasePHashThreshold_Click"
                                ToolTip="Increase the pHash match threshold by 1%" />
                        <TextBlock Text="(90%–100%)" VerticalAlignment="Center"
                                   Foreground="#667085" FontSize="12" Margin="9,0,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Compare file types:" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="#344054" Margin="0,0,12,0" />
                    <CheckBox x:Name="CompareImagesCheckBox" Content="Images"
                              IsChecked="True" Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Checked="MediaTypeCheckBox_Changed"
                              Unchecked="MediaTypeCheckBox_Changed" />
                    <CheckBox x:Name="CompareVideosCheckBox" Content="Videos"
                              IsChecked="False" VerticalAlignment="Center"
                              Checked="MediaTypeCheckBox_Changed"
                              Unchecked="MediaTypeCheckBox_Changed" />
                </StackPanel>

            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="8" Margin="0,0,0,4" Background="White"
                BorderBrush="#E2E6EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusTextBlock" Grid.Row="0" Grid.Column="0"
                           Text="Choose both folders to begin."
                           Foreground="#475467" FontSize="13" />
                <TextBlock x:Name="IndexingEtaTextBlock" Grid.Row="0" Grid.Column="1"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="#667085" FontSize="11" Visibility="Collapsed" />
                <Button x:Name="PauseIndexingButton" Grid.Row="0" Grid.Column="2"
                        Padding="4,2,4,2"
                        Width="30"
                        Height="24"
                        ToolTip="Pause indexing"
                        AutomationProperties.Name="Pause indexing"
                        Click="PauseIndexing_Click" IsEnabled="False">
                    <Path x:Name="PauseIndexingIcon"
                          Data="M 2,1 H 5 V 11 H 2 Z M 7,1 H 10 V 11 H 7 Z"
                          Width="10" Height="12" Stretch="Uniform" Fill="#344054" />
                </Button>
                <TextBlock x:Name="CacheStatusTextBlock" Grid.Row="2" Grid.ColumnSpan="3"
                           Text="Cache files: choose both folders."
                           Foreground="#667085" FontSize="11" TextWrapping="Wrap" />
                <ScrollViewer x:Name="CacheFilesScrollViewer" Grid.Row="4" Grid.ColumnSpan="3"
                              MaxHeight="76" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <TextBlock x:Name="CacheFilesTextBlock" Foreground="#667085" FontSize="10"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <ProgressBar x:Name="ProgressBar" Grid.Row="6" Height="9" Minimum="0" Maximum="100"
                             Grid.ColumnSpan="3" Value="0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E6EF"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Matching media files" FontSize="16" FontWeight="SemiBold"
                               Foreground="#172033" />
                    <TextBlock x:Name="ResultsCountTextBlock" DockPanel.Dock="Right" Foreground="#667085"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="ResultsList" Grid.Row="1" ItemsSource="{Binding Matches}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="12,0,12,12" Padding="14" Background="#FBFCFE"
                                    BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,3,14,0"
                                              ToolTip="Select this current-folder copy for the Recycle Bin" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="250" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="MASTER STORAGE" FontSize="10" FontWeight="Bold"
                                                       Foreground="#667085" Margin="0,0,0,7" />
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding MasterDetails}"
                                                           Width="170" Margin="0,0,12,0"
                                                           Foreground="#667085" FontSize="11"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Grid Height="130" Width="180" Background="#EEF2FA">
                                                    <Image Source="{Binding MasterThumbnail}"
                                                           Stretch="Uniform" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding MasterVideoLabel}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextAlignment="Center" Foreground="#475467"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                            </DockPanel>
                                            <TextBlock Text="{Binding MasterPath}" Margin="0,7,0,0"
                                                       Foreground="#344054" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CURRENT FILE — COPY" FontSize="10" FontWeight="Bold"
                                                       Foreground="#3157D5" Margin="0,0,0,7" />
                                            <DockPanel LastChildFill="True">
                                                <Grid Height="130" Width="180" Background="#EEF2FA">
                                                    <Image Source="{Binding CurrentThumbnail}"
                                                           Stretch="Uniform" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding CurrentVideoLabel}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextAlignment="Center" Foreground="#475467"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentDetails}"
                                                           Width="170" Margin="12,0,0,0"
                                                           Foreground="#667085" FontSize="11"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding CurrentPath}" Margin="0,7,0,0"
                                                       Foreground="#344054" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <TextBlock Text="COMPARISON DETAILS" FontSize="10" FontWeight="Bold"
                                                   Foreground="#667085" Margin="0,0,0,7" />
                                        <TextBox Text="{Binding ComparisonDetails, Mode=OneWay}" IsReadOnly="True"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="100" Padding="10"
                                                 Background="#F4F6FA" BorderBrush="#E2E6EF"
                                                 Foreground="#344054" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
